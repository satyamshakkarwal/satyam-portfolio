# Netlify response headers.
# CSS and JS are always linked with a ?v= number that changes on every update,
# so browsers can keep them for a year and never re-check them between pages.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/v2/site.css
  Cache-Control: public, max-age=31536000, immutable
/assets/v2/site.js
  Cache-Control: public, max-age=31536000, immutable
/assets/v2/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Images keep their file names when replaced, so cache them for a day only,
# and let the browser show the cached copy while it checks for a newer one.
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Pages: a phone may reuse a page it fetched in the last 5 minutes (each page fetches
# the main pages once idle, and again when the menu opens), then it checks again. One by one on purpose:
# a catch-all /* rule would also match the asset rules above and merge two Cache-Control values.
/
  Cache-Control: public, max-age=300, must-revalidate
/index.html
  Cache-Control: public, max-age=300, must-revalidate
/about
  Cache-Control: public, max-age=300, must-revalidate
/about.html
  Cache-Control: public, max-age=300, must-revalidate
/projects
  Cache-Control: public, max-age=300, must-revalidate
/projects.html
  Cache-Control: public, max-age=300, must-revalidate
/contact
  Cache-Control: public, max-age=300, must-revalidate
/contact.html
  Cache-Control: public, max-age=300, must-revalidate
/project
  Cache-Control: public, max-age=300, must-revalidate
/project.html
  Cache-Control: public, max-age=300, must-revalidate
